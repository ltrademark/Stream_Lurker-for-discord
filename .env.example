# --- Discord ---------------------------------------------------------------
# Developer Portal -> your app -> OAuth2 -> Client ID / Client Secret.
# Used for sign-in and to read which servers you moderate.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Twitch ----------------------------------------------------------------
# dev.twitch.tv/console/apps -> Register Your Application, Client Type:
# Confidential. Used server-side only, for Helix stream metadata.
# Leave blank and the app still runs; channel cards just show no metadata.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Server ----------------------------------------------------------------
# Where this app is reachable. Used to build the OAuth redirect_uri, which must
# match a Redirect registered in the Discord portal EXACTLY.
#   local dev : http://localhost:5173
#   deployed  : https://your-domain
# Defaults to http://localhost:<PORT> when unset.
PUBLIC_BASE_URL=http://localhost:5173

# Any long random string. Signs the session cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
