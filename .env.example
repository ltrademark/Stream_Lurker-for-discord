# --- Discord ---------------------------------------------------------------
# Developer Portal -> your app -> OAuth2 -> Client ID / Client Secret.
# The client ID is also your Activity's proxy subdomain: <id>.discordsays.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Same value as DISCORD_CLIENT_ID again. Vite only exposes variables prefixed
# with VITE_ to browser code, and the client needs the ID to construct the SDK.
VITE_DISCORD_CLIENT_ID=

# --- Twitch ----------------------------------------------------------------
# dev.twitch.tv/console/apps -> Register Your Application.
# Used server-side only, for Helix stream metadata (client_credentials grant).
# Leave blank and the app still runs; channel cards just show no metadata.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Server ----------------------------------------------------------------
# Any long random string. Signs the session tokens the WebSocket authenticates
# with. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
